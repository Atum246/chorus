{
  "name": "chorus",
  "version": "1.0.0",
  "description": "🎵 Chorus — Open-source AI agent brain for n8n. Turn workflows into autonomous agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chorus": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli/index.js', '755')\"",
    "dev": "tsx watch src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "n8n",
    "ai-agent",
    "automation",
    "open-source",
    "workflow",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "eventsource-parser": "^1.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "inquirer": "^9.2.0",
    "ioredis": "^5.4.0",
    "json5": "^2.2.3",
    "nanoid": "^5.0.0",
    "openai": "^4.50.0",
    "ora": "^8.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "sqlite3": "^5.1.0",
    "tiktoken": "^1.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
