# 🎵 Chorus Environment Variables

# ═══════════════════════════════════════════════════════════════
# n8n Configuration
# ═══════════════════════════════════════════════════════════════
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# ═══════════════════════════════════════════════════════════════
# LLM Configuration
# ═══════════════════════════════════════════════════════════════
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════
# Provider API Keys (set the ones you use)
# ═══════════════════════════════════════════════════════════════

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_API_KEY=AIza...

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-...

# Groq (fast inference)
GROQ_API_KEY=gsk_...

# Together AI
TOGETHER_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=...

# Mistral AI
MISTRAL_API_KEY=...

# Fireworks AI
FIREWORKS_API_KEY=...

# Perplexity
PERPLEXITY_API_KEY=...

# Cohere
COHERE_API_KEY=...

# OpenRouter (access many models)
OPENROUTER_API_KEY=sk-or-...

# xAI Grok
XAI_API_KEY=xai-...

# Replicate
REPLICATE_API_TOKEN=r8_...

# SambaNova
SAMBANOVA_API_KEY=...

# Cerebras
CEREBRAS_API_KEY=...

# Lepton AI
LEPTON_API_KEY=...

# Novita AI
NOVITA_API_KEY=...

# Hyperbolic
HYPERBOLIC_API_KEY=...

# Lambda
LAMBDA_API_KEY=...

# Chutes AI
CHUTES_API_KEY=...

# Kluster AI
KLUSTER_API_KEY=...

# ═══════════════════════════════════════════════════════════════
# Local Providers (no API key needed)
# ═══════════════════════════════════════════════════════════════
# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234

# vLLM
VLLM_BASE_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════
# Memory
# ═══════════════════════════════════════════════════════════════
CHORUS_MEMORY_BACKEND=sqlite
CHORUS_MEMORY_PATH=./data/chorus-memory.db

# ═══════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════
CHORUS_LOG_LEVEL=info
CHORUS_LOG_FORMAT=pretty

# ═══════════════════════════════════════════════════════════════
# Config file (optional)
# ═══════════════════════════════════════════════════════════════
CHORUS_CONFIG=./chorus.config.yaml
